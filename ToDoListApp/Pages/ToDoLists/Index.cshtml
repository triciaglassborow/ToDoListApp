@page
@model ToDoListApp.Pages.ToDoLists.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ToDoList[0].ListName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ToDoList[0].ToDoTasks)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.ToDoList) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.ListName)
            </td>
            <td>
                @Html.DisplayFor(model => item.ToDoTasks)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-listid="@item.ListID">Edit</a> |
                <a asp-page="./Details" asp-route-listid="@item.ListID">Details</a> |
                <a asp-page="./Delete" asp-route-listid="@item.ListID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
